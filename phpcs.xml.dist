<?xml version="1.0"?>
<ruleset name="HyperTaxonomy">
    <description>WordPress Coding Standards for HyperTaxonomy plugin.</description>

    <file>.</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <!-- Local developer scripts; not shipped (see utils/package.sh). -->
    <exclude-pattern>*/utils/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="tab-width" value="4"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <config name="minimum_wp_version" value="6.6"/>
    <config name="testVersion" value="7.4-"/>

    <rule ref="PHPCompatibilityWP"/>

    <rule ref="WordPress">
        <!-- Project uses 4-space indentation consistently throughout.
             Tab enforcement would require a full-project reformat. -->
        <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>

        <!-- Designed for tab-indented code: with 4-space indentation it flags
             deliberate alignment of continuation lines. -->
        <exclude name="Universal.WhiteSpace.PrecisionAlignment"/>

        <!-- Not a WordPress rule (Squiz). WordPress Core itself does not require
             inline comments to end with a full stop. -->
        <exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>

        <!-- Alignment of => and = is a formatting opinion, not correctness.
             Produces excessive noise across every file. -->
        <exclude name="WordPress.Arrays.MultipleStatementAlignment"/>

        <!-- Extremely pedantic multi-line function call structure (opening paren
             must be last on line, one arg per line, closing paren on own line).
             The actual WordPress guidelines do not mandate this layout. -->
        <exclude name="PEAR.Functions.FunctionCallSignature"/>

        <!-- Translators comments and ordered placeholders are good practice for
             submitted plugins but noisy during active development. -->
        <exclude name="WordPress.WP.I18n.MissingTranslatorsComment"/>
        <exclude name="WordPress.WP.I18n.MultipleOrderedPlaceholders"/>

        <!-- The suite uses 'wordpress' as a platform slug (TermConnect link types), so
             auto-capitalizing it to "WordPress" changes behavior. -->
        <exclude name="WordPress.WP.CapitalPDangit"/>

        <!-- ?: is used deliberately as "if empty, use this fallback". ?? is not a
             substitute (it only catches null), and expanding it repeats the expression. -->
        <exclude name="Universal.Operators.DisallowShortTernary"/>

        <!-- Suite convention is class-{feature}.php, not class-{prefix}-{class-name}.php. -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <!-- Indent with 4 spaces, never tabs (the WordPress default is tabs). -->
    <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>
    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <properties>
            <property name="indent" value="4"/>
            <property name="tabIndent" value="false"/>
        </properties>
    </rule>
    <rule ref="WordPress.Arrays.ArrayIndentation">
        <properties>
            <property name="tabIndent" value="false"/>
        </properties>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="hypertaxonomy"/>
            </property>
        </properties>
    </rule>

    <!-- Capabilities registered by HyperTaxonomy_Capabilities. -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="manage_hypertaxonomy_settings"/>
                <element value="manage_term_relationships"/>
                <element value="manage_term_redirects"/>
                <element value="manage_term_icons"/>
                <element value="manage_term_visibility"/>
                <element value="manage_term_sticky_posts"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="htax"/>
                <element value="hypertaxonomy"/>
            </property>
        </properties>
    </rule>

    <!-- Tab templates required from inside the settings page render function, so
         their variables are function-local, not globals. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
        <exclude-pattern>*/includes/admin/export-ui.php</exclude-pattern>
        <exclude-pattern>*/includes/admin/tag-groups-migrate-ui.php</exclude-pattern>
        <exclude-pattern>*/includes/admin/tag-groups-sync-ui.php</exclude-pattern>
    </rule>

    <!-- export-hypertaxonomy.php must query custom tables directly — these are not
         standard WordPress tables and cannot use WP_Query or cached WP APIs. -->
    <rule ref="WordPress.DB.DirectDatabaseQuery">
        <exclude-pattern>*/export-hypertaxonomy.php</exclude-pattern>
    </rule>

    <!-- class-activator.php intentionally runs ALTER TABLE during plugin activation.
         $Key_name, $Index_type, $Column_name are MySQL-defined column names from
         SHOW INDEX output — they are not PHP variables we control. -->
    <rule ref="WordPress.DB.DirectDatabaseQuery.SchemaChange">
        <exclude-pattern>*/class-activator.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase">
        <exclude-pattern>*/class-activator.php</exclude-pattern>
    </rule>

    <!-- ajax-search-endpoint.php runs before WordPress loads and must manipulate
         $wp_filter directly to inject cache-disabling hooks. Nonce verification
         happens on the very next line after request data is read. -->
    <rule ref="WordPress.WP.GlobalVariablesOverride">
        <exclude-pattern>*/ajax-search-endpoint.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.Security.NonceVerification">
        <exclude-pattern>*/ajax-search-endpoint.php</exclude-pattern>
        <!-- activation.php checks isset( $_GET['htax_search'] ) only to decide whether
             to add security response headers — no form data is read or processed. -->
        <exclude-pattern>*/activation.php</exclude-pattern>
    </rule>
</ruleset>
